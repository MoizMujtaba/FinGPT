+name: Finogrid CI
+
+on:
+  push:
+    branches: ["master", "claude/**", "feature/**"]
+    paths:
+      - "finogrid/**"
+      - ".github/workflows/finogrid-ci.yml"
+  pull_request:
+    branches: ["master"]
+    paths:
+      - "finogrid/**"
+
+env:
+  PYTHON_VERSION: "3.12"
+
+jobs:
+  # ── Lint ────────────────────────────────────────────────────────────────────
+  lint:
+    name: Lint (ruff)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ env.PYTHON_VERSION }}
+          cache: pip
+
+      - name: Install linter
+        run: pip install ruff
+
+      - name: Run ruff
+        run: ruff check finogrid/ --select E,W,F,I --ignore E501
+
+  # ── Unit tests ──────────────────────────────────────────────────────────────
+  unit-tests:
+    name: Unit Tests
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ env.PYTHON_VERSION }}
+          cache: pip
+
+      - name: Install dependencies
+        run: pip install -r finogrid/requirements.txt pytest pytest-asyncio pytest-cov
+
+      - name: Run unit tests
+        working-directory: finogrid
+        env:
+          DATABASE_URL: "postgresql+asyncpg://finogrid:password@localhost:5432/finogrid"
+          PUBSUB_PROJECT_ID: "test-project"
+          JWT_SECRET_KEY: "test-secret"
+          KYA_ENABLED: "false"
+          CHAIN_ENABLED: "false"
+        run: |
+          pytest tests/unit/ -v \
+            --cov=services --cov=corridors --cov=mcp \
+            --cov-report=xml --cov-report=term-missing \
